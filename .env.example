# Konteyner Cafe & Roastery Görevli Paneli Güvenlik Ayarları
# ÖNEMLİ: Bu dosyaya asla gerçek şifre/anahtar yazmayın. Gerçek değerler .env.local (yerel) ve Vercel ortam değişkenlerinde tutulur.
STAFF_USERNAME=degistir_guvenli_kullanici_adi
STAFF_PASSWORD=degistir_guclu_sifre
# En az 16 karakter, tahmin edilemez rastgele değer olmalıdır (örn: openssl rand -base64 48)
AUTH_SECRET=degistir_en_az_16_karakter_rastgele_anahtar

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (bulut veritabanı kullanılıyorsa doldurulur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ÖNEMLİ: Bu anahtar yalnızca sunucuda kullanılır, asla NEXT_PUBLIC_ öneki almamalı ve istemciye sızmamalıdır.
SUPABASE_SERVICE_ROLE_KEY=
